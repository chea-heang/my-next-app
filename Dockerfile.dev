###############################################################################
#  Next.js — Development Dockerfile
#
#  • Starts with `next dev` for fast-refresh / hot-reload.
#  • node_modules are installed inside the image; the host bind-mount
#    covers /app but not /app/node_modules (named volume wins).
###############################################################################

FROM node:22-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Install dependencies first (cached layer)
COPY package*.json ./

RUN npm install

# Copy source (overridden by bind-mount at runtime)
COPY . .

EXPOSE 3000

# Next.js dev server — WATCHPACK_POLLING is needed inside Docker on
# Windows/Mac where inotify events don't cross the VM boundary reliably.
ENV WATCHPACK_POLLING=true

CMD ["npm", "run", "dev"]

